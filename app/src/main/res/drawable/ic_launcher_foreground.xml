<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon foreground: a stylized "T" inside a shield outline.
    Vector drawable scales to any density. Per Material3 adaptive icon spec
    the foreground must fit within the inner 66% of the 108x108dp canvas
    (so 72x72dp safe zone).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Shield outline -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,28 L74,36 L74,56 C74,68 65,76 54,80 C43,76 34,68 34,56 L34,36 Z" />
    <!-- Tote "T" mark -->
    <path
        android:fillColor="#FF5722"
        android:pathData="M44,42 L64,42 L64,46 L57,46 L57,68 L51,68 L51,46 L44,46 Z" />
</vector>
