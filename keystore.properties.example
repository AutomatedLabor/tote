# Copy this file to keystore.properties (gitignored) for local release builds.
# For CI, these are provided as GitHub Actions secrets:
#   TOTE_KEYSTORE_BASE64, TOTE_KEYSTORE_PASSWORD, TOTE_KEY_ALIAS, TOTE_KEY_PASSWORD
storeFile=keystore/tote-release.keystore
storePassword=your-store-password-here
keyAlias=tote-release
keyPassword=your-key-password-here
