root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{kt,kts}]
ij_kotlin_imports_layout = *
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_filename = enabled

[*.{yml,yaml,toml}]
indent_size = 2

[*.{xml,json}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off
